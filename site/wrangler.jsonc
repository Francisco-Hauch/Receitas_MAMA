{
  // Configuração do deploy na Cloudflare.
  //
  // Por que Workers e não Pages: a Cloudflare declarou que todo investimento
  // novo vai para Workers, e o Pages ficou em manutenção. E foi essa escolha
  // que permitiu o formulário do site — o mesmo Worker que entrega os arquivos
  // agora também atende /api/receita, sem trocar de plataforma.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "receitas-mamae",
  "compatibility_date": "2026-08-09",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist/",
    // O site roteia pelo # da URL, então só "/" é pedido de verdade. Isso aqui
    // garante que qualquer outro caminho caia no index em vez de dar 404.
    "not_found_handling": "single-page-application",
    // ...e isto impede que /api/receita caia na regra acima e vire index.html.
    // Sem esta linha o formulário recebe HTML onde esperava JSON.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_OWNER": "Morbidmango873",
    "GITHUB_REPO": "Receitas_MAMA"
  }
  // GITHUB_TOKEN NÃO fica aqui: é secret, posto no painel da Cloudflare em
  // Settings → Variables and Secrets → Add → Secret.
}
