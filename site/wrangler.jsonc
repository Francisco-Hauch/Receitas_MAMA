{
  // Configuração do deploy na Cloudflare.
  //
  // Por que Workers e não Pages: a Cloudflare declarou que todo investimento
  // novo vai para Workers, e o Pages ficou em manutenção. E foi essa escolha
  // que permitiu o formulário e o login — o mesmo Worker que entrega os
  // arquivos também atende /api/receita e /entrar, sem trocar de plataforma.
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Tem que ser IDÊNTICO ao nome do Worker no painel da Cloudflare, senão o
  // deploy cria um segundo Worker em vez de atualizar este. O painel gerou
  // "receitas-mama" (sem o "e"), e quem manda é ele.
  "name": "receitas-mama",
  // Não use a data de hoje: o runtime local do wrangler costuma estar um ou
  // dois dias atrás e recusa rodar com data futura.
  "compatibility_date": "2026-08-08",
  "main": "./src/worker.js",

  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",

    // As duas linhas que fazem o login existir:
    //   binding          -> o Worker passa a poder entregar os arquivos ele mesmo
    //   run_worker_first -> o Worker vê TODA requisição antes de qualquer
    //                       arquivo ser servido
    // Sem elas, a Cloudflare entregaria o bundle do React — com as receitas
    // dentro — antes que qualquer código nosso pudesse checar a sessão.
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Freio de tentativa de senha. Períodos aceitos são só 10 ou 60 segundos.
  // Dois limites: um por origem, contra alguém insistindo; outro geral, contra
  // muitas origens tentando pouco cada uma.
  "ratelimits": [
    {
      "name": "LIMITE_LOGIN",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LIMITE_GLOBAL",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "vars": {
    "GITHUB_OWNER": "Morbidmango873",
    "GITHUB_REPO": "Receitas_MAMA"
  }

  // NÃO ficam aqui, são secrets no painel (Settings → Variables and Secrets):
  //   GITHUB_TOKEN         token do GitHub
  //   SEGREDO_SESSAO       string aleatória que assina o cookie
  //   SENHA_FAMILIA_HASH   SHA-256 da senha de quem vê E manda receitas
  //   SENHA_VISITA_HASH    SHA-256 da senha de quem só vê (opcional)
  //
  // SENHA_HASH (a senha única de antes) continua valendo como "familia", para
  // não trancar ninguém do lado de fora durante a troca.
}
